# Copia este archivo a .env y completa con los valores de tu proyecto de
# Supabase (Project Settings > API). Nunca commitees .env.
# El prefijo EXPO_PUBLIC_ es obligatorio para que Expo exponga la variable
# al bundle del cliente (equivalente a NEXT_PUBLIC_ en la web).

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# URL de la app web desplegada (Vercel). Se usa para acciones que solo
# existen como Route Handler en la web, como eliminar cuenta
# (/api/cuenta) y para abrir la política de privacidad / términos.
EXPO_PUBLIC_WEB_URL=https://emprendeunjbg.com
