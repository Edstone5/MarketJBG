# Copia este archivo a .env.local y completa con los valores de tu proyecto
# de Supabase (Project Settings > API). Nunca commitees .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key (Project Settings > API > service_role). NUNCA la pongas
# con prefijo NEXT_PUBLIC_ ni la expongas al cliente: se usa solo en
# src/app/api/cuenta/route.ts (Route Handler) para eliminar cuentas.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL pública del sitio, usada para construir enlaces de confirmación de
# correo (ver src/lib/actions/auth.ts). En Vercel, ajústala a tu dominio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
