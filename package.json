{
  "name": "emprende-unjbg",
  "private": true,
  "version": "0.1.0",
  "description": "Catálogo de Emprendimientos Universitarios - UNJBG",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:mobile": "turbo run dev --filter=mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "node --test supabase/tests/politicas.test.mjs packages/core/tests/core.test.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.17",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "shell-quote": "1.12.0",
      "source-map-js": "1.2.2",
      "decode-uri-component": "0.5.0"
    }
  }
}
